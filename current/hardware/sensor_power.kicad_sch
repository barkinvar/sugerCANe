(symbol (lib_id "FRC_Sensor_CAN:R") (at 389.89 224.79 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "bcecacfd-8eb3-56da-a26d-74462dbaa987") (property "Reference" "R75" (at 389.89 218.29 0) (effects (font (size 1.27 1.27))))(property "Value" "10k" (at 389.89 220.79 0) (effects (font (size 1.016 1.016))))(property "Footprint" "FRC_Sensor_CAN:R_0805_2012Metric" (at 389.89 224.79 0) (effects (font (size 1.27 1.27)) (hide yes)))(property "Datasheet" "" (at 389.89 224.79 0) (effects (font (size 1.27 1.27)) (hide yes)))(property "MPN" "0805W8F1002T5E" (at 389.89 224.79 0) (effects (font (size 1.27 1.27)) (hide yes)))(property "Notes" "100k gate pulldown keeps Q3 off during MCU reset/unpowered, so Q2 inhibits U9. 10k pulldown provides extra reset/leakage margin." (at 389.89 224.79 0) (effects (font (size 1.27 1.27)) (hide yes)))(pin "1" (uuid "aae4869a-1494-5015-b2f2-0f12e6859890"))(pin "2" (uuid "64e16e2d-7a6c-57c3-be05-e33f5b6d7ca9"))(instances (project "FRC_Sensor_CAN" (path "/32fd904d-6274-5c4e-88d3-bb1b48cbb6d1/0aacf9c7-060e-58ed-b759-3ac31ac433d8" (reference "R75") (unit 1)))) )
(text "U9 is after the boost reservoir: sensor shorts do not directly discharge it.\nR70 uses raw 12 V to inhibit U9 through Q2; PB7 HIGH enables via Q3. R75 defaults OFF without MCU power.\nHardware UVLO requires about 11.1 V upstream.\nOVCSEL is intentionally open for the 13.8 V-class fault clamp. No reverse-powered output support.\nBoth rails: 300 mA useful load shared between all ports; protection never depends on firmware." (at 15 260 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "2ebd54a7-ae49-5108-a74a-1c89d36ebf7b"))
(embedded_fonts no))
