(footprint "R_1206_Kelvin_Sense_Taps" (version 20260206) (generator "pcbnew") (layer "F.Cu") (attr smd)
(descr "1206 two-terminal resistor with Kelvin PCB branches: physical left terminal 1+3, right terminal 2+4")
(net_tie_pad_groups "1,3" "2,4")
(property "Reference" "REF**" (at 0 -1.8 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
(property "Value" "0.1" (at 0 1.8 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
(fp_rect (start -2.35 -1.25) (end 2.35 1.25) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
(fp_rect (start -1.55 -0.8) (end 1.55 0.8) (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
(pad "1" smd roundrect (at -1.52 0) (size 1.1 1.9) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
(pad "2" smd roundrect (at 1.52 0) (size 1.1 1.9) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
(pad "3" smd rect (at -1.02 -0.8) (size 0.4 0.3) (layers "F.Cu" "F.Mask"))
(pad "4" smd rect (at 1.02 -0.8) (size 0.4 0.3) (layers "F.Cu" "F.Mask"))
(model "${KIPRJMOD}/library/3d/R_1206_3216Metric.step" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0))))
