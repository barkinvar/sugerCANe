# Generated CAD and PDF deliverables: preserve bytes, avoid text diffs/merges.
# No current-tree files require LFS; historical raw traces may still use it.
*.step binary
*.stp binary
*.pdf binary

# CSV exports use the conventional CRLF terminator; preserve delivered bytes.
*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve upstream source and machine-generated SVG/HTML formatting verbatim.
rev_c/firmware/third_party/** -whitespace
rev_c/output/**/*.svg -whitespace
rev_c/output/assembly/interactive_bom.html -whitespace
# Compiler-generated programming images/maps retain toolchain formatting.
*.hex whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
rev_c/firmware/build/*.map -whitespace
