(version 1)
# Manufacturer requires 0.020 inch from contact pads to other tracks/signals.
# Adjacent contact pads are deliberately excluded: their standard pattern is fixed.
(rule "TC2050 contact to foreign track clearance"
 (condition "A.memberOfFootprint('J8') && (B.Type == 'Track' || B.Type == 'Via')")
 (constraint clearance (min 0.508mm)))
